{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "@GOOGLE_SERVICES_JSON",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "$GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "$GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_STRAVA_CLIENT_ID": "$STRAVA_CLIENT_ID",
        "EXPO_PUBLIC_OAUTH_BACKEND_URL": "$OAUTH_BACKEND_URL"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "@GOOGLE_SERVICES_JSON",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "$GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "$GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_STRAVA_CLIENT_ID": "$STRAVA_CLIENT_ID",
        "EXPO_PUBLIC_OAUTH_BACKEND_URL": "$OAUTH_BACKEND_URL"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "@GOOGLE_SERVICES_JSON",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "$GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "$GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_STRAVA_CLIENT_ID": "$STRAVA_CLIENT_ID",
        "EXPO_PUBLIC_OAUTH_BACKEND_URL": "$OAUTH_BACKEND_URL"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
