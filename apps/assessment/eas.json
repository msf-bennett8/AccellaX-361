{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "$GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "$GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_STRAVA_CLIENT_ID": "$STRAVA_CLIENT_ID",
        "EXPO_PUBLIC_STRAVA_CLIENT_SECRET": "$STRAVA_CLIENT_SECRET"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "$GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "$GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_STRAVA_CLIENT_ID": "$STRAVA_CLIENT_ID",
        "EXPO_PUBLIC_STRAVA_CLIENT_SECRET": "$STRAVA_CLIENT_SECRET"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "$GOOGLE_WEB_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "$GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_STRAVA_CLIENT_ID": "$STRAVA_CLIENT_ID",
        "EXPO_PUBLIC_STRAVA_CLIENT_SECRET": "$STRAVA_CLIENT_SECRET"
      }
    }
  },
  "submit": {
    "production": {}
  }
}