# ========== APP INFO ==========
APP_NAME=AccellaX 361° Assessment
APP_VERSION=1.0.0
APP_ENV=development

# ========== FIREBASE CONFIGURATION ==========
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ========== ACADEMY CONFIGURATION ==========
EXPO_PUBLIC_ACADEMY_ID=academy_accellax361_main
EXPO_PUBLIC_ACADEMY_NAME=AccellaX 361°

# ========== API ENDPOINTS (OPTIONAL) ==========
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# ========== DATABASE CONFIGURATION (FOR WEB BACKEND) ==========
DB_CONNECTION=mysql
DB_HOST=your_database_host
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_username
DB_PASSWORD=your_password

# ========== DEVELOPMENT FLAGS ==========
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_AUTO_SYNC=true

# ========== FEATURE FLAGS ==========
EXPO_PUBLIC_ENABLE_VIDEO_RECORDING=false
EXPO_PUBLIC_ENABLE_VOICE_INPUT=false
EXPO_PUBLIC_ENABLE_CAMERA=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false

# ========== SYNC CONFIGURATION ==========
EXPO_PUBLIC_SYNC_INTERVAL=300000
EXPO_PUBLIC_BATCH_SIZE=50
EXPO_PUBLIC_MAX_RETRY_ATTEMPTS=3

# ========== ANALYTICS (OPTIONAL) ==========
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ANALYTICS_ID=
