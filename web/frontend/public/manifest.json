  "protocol_handlers": [
    {
      "protocol": "web+accellax",
      "url": "/handle?type=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "text/csv": [".csv"],
        "application/vnd.ms-excel": [".xls"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "dir": "ltr",
  "lang": "en-US",
  "iarc_rating_id": "",
  "custom": {
    "version": "2.1.0",
    "build": "2025.01.20",
    "features": {
      "offline_mode": true,
      "push_notifications": true,
      "background_sync": true,
      "file_import": true,
      "biometric_auth": true,
      "real_time_sync": true,
      "multi_role_dashboards": true,
      "parent_portal": true,
      "coach_management": true,
      "analytics_reporting": true,
      "payment_tracking": true,
      "messaging_system": true,
      "event_scheduling": true
    },
    "minimum_requirements": {
      "chrome": "90",
      "firefox": "88",
      "safari": "14",
      "edge": "90",
      "samsung_internet": "15"
    },
    "performance": {
      "cache_strategy": "network-first",
      "offline_storage": "indexeddb",
      "service_worker_version": "2.1.0",
      "max_cache_age_days": 7,
      "background_sync_interval_minutes": 15
    },
    "api_endpoints": {
      "production": "https://api.accellax.com",
      "staging": "https://staging-api.accellax.com",
      "development": "http://localhost:8000"
    },
    "firebase": {
      "project_id": "accellax-361",
      "supports_fcm": true,
      "supports_firestore": true,
      "supports_auth": true,
      "supports_storage": true,
      "supports_functions": true,
      "analytics_enabled": true
    },
    "academy": {
      "default_name": "NextGen Multisport Academy",
      "sports": [
        "Soccer",
        "Basketball",
        "Athletics",
        "Volleyball",
        "Swimming",
        "Tennis"
      ],
      "location": "Nairobi, Kenya",
      "timezone": "Africa/Nairobi",
      "currency": "KES",
      "supported_age_groups": [
        "Under 6",
        "Under 8",
        "Under 10",
        "Under 12",
        "Under 14",
        "Under 16",
        "Under 18",
        "Adult"
      ]
    },
    "user_roles": [
      "super_admin",
      "academy_owner",
      "coach",
      "parent",
      "kid",
      "sponsor"
    ],
    "supported_features_by_role": {
      "super_admin": [
        "full_access",
        "user_management",
        "system_settings",
        "analytics",
        "reports",
        "billing"
      ],
      "academy_owner": [
        "academy_management",
        "coach_management",
        "attendance_overview",
        "reports",
        "payments",
        "messaging"
      ],
      "coach": [
        "mark_attendance",
        "view_kids",
        "session_management",
        "basic_reports",
        "messaging"
      ],
      "parent": [
        "view_kid_profile",
        "attendance_history",
        "payments",
        "messaging",
        "notifications"
      ],
      "kid": [
        "view_profile",
        "view_attendance",
        "view_schedule",
        "achievements"
      ],
      "sponsor": [
        "view_sponsored_kids",
        "view_reports",
        "messaging"
      ]
    },
    "integrations": {
      "google_analytics": true,
      "firebase_analytics": true,
      "payment_gateways": ["mpesa", "stripe", "paypal"],
      "email_service": "sendgrid",
      "sms_service": "africastalking",
      "cloud_storage": "firebase_storage"
    },
    "security": {
      "auth_providers": ["email", "google", "phone"],
      "two_factor_enabled": true,
      "session_timeout_minutes": 60,
      "password_policy": {
        "min_length": 8,
        "require_uppercase": true,
        "require_lowercase": true,
        "require_numbers": true,
        "require_special_chars": true
      },
      "data_encryption": true,
      "secure_communications": true
    },
    "localization": {
      "supported_languages": ["en", "sw"],
      "default_language": "en",
      "date_format": "DD/MM/YYYY",
      "time_format": "24h",
      "number_format": "1,234.56"
    },
    "app_metadata": {
      "last_updated": "2025-01-20",
      "author": "AccellaX 361° Development Team",
      "website": "https://accellax.com",
      "support_email": "support@accellax.com",
      "privacy_policy": "https://accellax.com/privacy",
      "terms_of_service": "https://accellax.com/terms",
      "license": "Proprietary"
    }
  }
